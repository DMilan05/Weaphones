<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="16dp"
    tools:context=".MainActivity">
    <ImageView
        android:id="@+id/flagHU"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_flag_hu"
        android:layout_alignParentEnd="true"
        android:layout_margin="8dp" />

    <ImageView
        android:id="@+id/flagEN"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_flag_en"
        android:layout_toLeftOf="@id/flagHU"
        android:layout_margin="8dp" />
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fegyverkategóriák"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/quizButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Indítsd a Kvízt"
        android:textStyle="bold"
        android:textSize="18sp"
        android:background="@drawable/button_background"
        android:textColor="#FFFFFF"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnLeaderboard"
        android:text="Eredmények"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/quizButton"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/categoryListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/titleText"
        android:layout_above="@id/btnLeaderboard"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:layout_marginBottom="16dp" />

</RelativeLayout>